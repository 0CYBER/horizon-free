{
 "default": [],
 "hosts": {
  "macmini": {
   "ssh": "macmini",
   "root": "code/horizon-parity",
   "shell": "zsh -lc",
   "setup": "source ~/.cargo/env && export JAVA_HOME=$(/usr/libexec/java_home -v 25) && export PATH=$JAVA_HOME/bin:$PATH",
   "python": "/opt/homebrew/bin/python3.13",
   "rsync": "/opt/homebrew/bin/rsync",
   "jobs": 14,
   "exclude": {}
  },
  "thinkpad": {
   "ssh": "thinkpad",
   "root": "code/horizon-parity",
   "shell": "sh -c",
   "jobs": 2,
   "nice": 19,
   "environment": {
    "PARITY_BUILD_JOBS": "2"
   },
   "note": "hosts the Claude account pool: two harnesses at most, at the lowest priority",
   "setup": "export PKG_CONFIG_PATH=$HOME/code/horizon-parity/alsa-dev/lib/pkgconfig"
  }
 },
 "local_only": {
  "save_roundtrip": "runs the game on a virtual screen (vscreen) with a null ALSA device, or offscreen in the logged-in macOS session"
 },
 "linux_only": {}
}
